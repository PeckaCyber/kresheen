# Build environment for the Linux desktop packages. glibc 2.28 (Rocky Linux 8): a PyInstaller bundle needs a glibc at
# least as new as the one it was built against, so building on an old base makes it run on Debian 11+, Ubuntu 20.04+,
# RHEL/Rocky 8+ and Fedora. Python is uv's standalone 3.13 (a shared libpython, which PyInstaller needs).
FROM ghcr.io/astral-sh/uv:0.13.5@sha256:32a7bb39b496babbd997b0a39a4d66c126bdaf5661b302bf6f06abda8deca6ff AS uv

FROM rockylinux/rockylinux:8@sha256:e8a49c5403b687db05d4d67333fa45808fbe74f36e683cec7abb1f7d0f2338c6
# binutils: PyInstaller reads shared-library dependencies with objdump. Versions come from the pinned base's repos.
# hadolint ignore=DL3041
RUN dnf install -y --setopt=install_weak_deps=False binutils tar gzip findutils && dnf clean all
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_PYTHON_INSTALL_DIR=/opt/uv-python HOME=/tmp
RUN uv python install 3.13 && chmod -R a+rX /opt/uv-python && rm -rf /tmp/.cache
