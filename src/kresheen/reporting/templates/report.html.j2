<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Threat model: {{ r.application_name }}</title>
<style>
  :root { color-scheme: light; }
  * { box-sizing: border-box; }
  body { font: 14px/1.5 -apple-system, "Segoe UI", Helvetica, Arial, sans-serif; color: #212529; margin: 0; background: #f1f3f5; }
  main { max-width: 980px; margin: 0 auto; padding: 24px 32px 48px; background: #fff; }
  h1 { font-size: 26px; margin: 0 0 4px; }
  h2 { font-size: 19px; margin: 32px 0 8px; padding-bottom: 4px; border-bottom: 2px solid #dee2e6; }
  h3 { font-size: 15px; margin: 18px 0 6px; }
  .muted { color: #6c757d; }
  .note { background: #fff3cd; border: 1px solid #ffe69c; border-radius: 6px; padding: 8px 12px; margin: 12px 0; }
  .screen-only { background: #e7f1ff; border: 1px solid #b6d4fe; border-radius: 6px; padding: 8px 12px; margin: 0 0 16px; }
  table { border-collapse: collapse; width: 100%; margin: 8px 0; }
  th, td { border: 1px solid #dee2e6; padding: 4px 8px; text-align: left; vertical-align: top; }
  th { background: #f8f9fa; font-weight: 600; }
  .counts { display: flex; flex-wrap: wrap; gap: 8px; margin: 8px 0; }
  .count { border: 1px solid #dee2e6; border-radius: 6px; padding: 6px 12px; min-width: 96px; }
  .count b { display: block; font-size: 20px; }
  .badge { display: inline-block; padding: 1px 8px; border-radius: 10px; font-size: 12px; font-weight: 600; color: #fff; background: #6c757d; }
  pre { white-space: pre-wrap; background: #f6f8fa; border: 1px solid #d0d7de; border-radius: 4px; padding: 6px 8px; font-size: 12px; margin: 4px 0; }
  .warn { background: #fff3cd; border: 1px solid #ffe69c; border-radius: 4px; padding: 8px 12px; margin: 8px 0; }
  .critical { background: #dc3545; } .high { background: #fd7e14; color: #000; }
  .medium { background: #ffc107; color: #000; } .low { background: #0dcaf0; color: #000; }
  .diagram { border: 1px solid #dee2e6; border-radius: 6px; padding: 8px; overflow-x: auto; }
  .diagram svg { display: block; margin: 0 auto; width: auto; height: auto; max-width: 100%; }
  .diagram-section { break-inside: avoid; }
  .legend { font-size: 12px; }
  .threat { border: 1px solid #dee2e6; border-left: 4px solid #6c757d; border-radius: 4px; padding: 8px 12px; margin: 8px 0; break-inside: avoid; }
  .threat.risk-critical { border-left-color: #dc3545; } .threat.risk-high { border-left-color: #fd7e14; }
  .threat.risk-medium { border-left-color: #ffc107; } .threat.risk-low { border-left-color: #0dcaf0; }
  .threat .title { font-weight: 600; }
  .threat ul { margin: 4px 0 4px 18px; padding: 0; }
  .meta { font-size: 12px; color: #495057; margin: 2px 0; }
  .element { break-after: avoid; }
  @media print {
    body { background: #fff; font-size: 11px; }
    main { max-width: none; padding: 0; }
    .screen-only { display: none; }
    h2 { break-after: avoid; }
    tr, .threat { break-inside: avoid; }
    /* A tall diagram must scale to fit one page, or it is split or dropped. */
    .diagram svg { max-height: 215mm; }
    a { color: inherit; text-decoration: none; }
  }
</style>
</head>
<body>
<main>
<div class="screen-only">To save this report as a PDF, use your browser's Print command (Ctrl/Cmd+P) and choose "Save as PDF".</div>

<h1>{{ r.application_name }}</h1>
<div class="muted">Threat model report{% if r.group_name %} &middot; {{ r.group_name }}{% endif %}</div>
{% if r.application_description %}<p>{{ r.application_description }}</p>{% endif %}

<table>
  <tr><th style="width:22%">Run</th><td>{{ r.run_id }} ({{ r.run_status }})</td></tr>
  <tr><th>Started</th><td>{{ r.run_started_at.strftime("%Y-%m-%d %H:%M UTC") }}</td></tr>
  {% if r.run_completed_at %}<tr><th>Completed</th><td>{{ r.run_completed_at.strftime("%Y-%m-%d %H:%M UTC") }}</td></tr>{% endif %}
  <tr><th>Report generated</th><td>{{ r.generated_at.strftime("%Y-%m-%d %H:%M UTC") }}</td></tr>
  <tr><th>Inputs</th><td>
    {% if r.sources %}
      <ul style="margin:0;padding-left:18px">{% for s in r.sources %}<li>{{ s.type }}{% if s.label %}: {{ s.label }}{% endif %}</li>{% endfor %}</ul>
    {% else %}None (a model drawn by hand){% endif %}
  </td></tr>
  {% if r.owner %}<tr><th>Owner</th><td>{{ r.owner }}</td></tr>{% endif %}
  {% if r.reviewer %}<tr><th>Reviewer</th><td>{{ r.reviewer }}</td></tr>{% endif %}
  {% if r.reviewed_at %}<tr><th>Marked reviewed</th><td>{{ r.reviewed_at.strftime("%Y-%m-%d") }}{% if r.reviewed_by %} by {{ r.reviewed_by }}{% endif %}</td></tr>{% endif %}
  {% if r.contributors %}<tr><th>Contributors</th><td>{{ r.contributors | join(", ") }}</td></tr>{% endif %}
</table>
<p class="note">Generated by a rule-based threat modeling engine from the inputs above. Treat it as a starting point and review it before relying on it.</p>

<h2>Summary</h2>
<div class="counts">
  <div class="count"><b>{{ r.summary.total }}</b>threats</div>
  <div class="count"><b>{{ r.summary.by_status.get("open", 0) }}</b>open</div>
  <div class="count"><b>{{ r.summary.by_status.get("mitigated", 0) }}</b>mitigated</div>
  <div class="count"><b>{{ r.summary.by_status.get("accepted", 0) }}</b>accepted</div>
  <div class="count"><b>{{ r.summary.by_status.get("not_applicable", 0) }}</b>not applicable</div>
  <div class="count"><b>{{ r.components | length }}</b>components</div>
  <div class="count"><b>{{ r.data_flows | length }}</b>data flows</div>
</div>
<table>
  <tr><th>Open threats by risk</th>{% for level in ["critical", "high", "medium", "low"] %}<td><span class="badge {{ level }}">{{ level }}</span> {{ r.summary.open_by_risk.get(level, 0) }}</td>{% endfor %}</tr>
</table>

<h2>Action plan</h2>
{% if r.open_actions %}
<p class="muted">The open threats below, grouped by the fix that addresses them and ranked by risk, with fixes for things found in your configuration ahead of generic checklist items. Do these first.</p>
<table>
  <tr><th>#</th><th>Fix</th><th>Risk</th><th>Why it is listed</th><th>Covers</th><th>Status</th></tr>
  {% for a in r.open_actions[:plan_limit] %}<tr>
    <td>{{ loop.index }}</td><td>{{ a.text }}</td><td><span class="badge {{ a.max_risk }}">{{ a.max_risk }}</span></td>
    <td>{{ a.basis }}</td>
    <td>{{ a.threat_count }} threat{{ "s" if a.threat_count != 1 }} on {{ a.elements | join(", ") }}{% if a.element_count > a.elements | length %} and {{ a.element_count - (a.elements | length) }} more{% endif %}</td>
    <td>{{ a.status | replace("_", " ") }}</td></tr>{% endfor %}
</table>
{% if r.open_actions | length > plan_limit %}<p class="muted">{{ r.open_actions | length - plan_limit }} more actions are in the action plan CSV export.</p>{% endif %}
{% else %}<p>No open actions: every threat is mitigated, accepted or not applicable.</p>{% endif %}
{% if r.closed_action_count %}<p class="muted">{{ r.closed_action_count }} action{{ "s are" if r.closed_action_count != 1 else " is" }} marked done or declined and not shown.</p>{% endif %}

<div class="diagram-section">
<h2>Data flow diagram</h2>
<div class="diagram">{{ diagram_svg | safe }}</div>
<p class="legend muted">Fill colour is the worst open finding on the component (red critical, orange high, yellow medium, blue low, green none found). Rounded box: process. Lined box: data store. Double-bordered box: external entity. Dashed outline: a trust boundary, or an element the owner marked out of scope. A grey outline means the component was added by hand. Faint dotted lines are mounts and configuration references, not data flows.</p>
</div>

<h3>Components</h3>
<table>
  <tr><th>Name</th><th>Type</th><th>Trust boundary</th><th>Open findings</th><th>Source</th></tr>
  {% for c in r.components %}
  <tr><td>{{ c.name }}{% if c.out_of_scope %} <span class="muted">(out of scope)</span>{% endif %}</td><td>{{ c.type | replace("_", " ") }}</td><td>{{ c.trust_boundary or "" }}</td><td>{{ c.open_finding_count }}</td><td>{{ "added by hand" if c.is_manual else "scanned" }}</td></tr>
  {% else %}<tr><td colspan="5" class="muted">No components.</td></tr>{% endfor %}
</table>
<h3>Data flows</h3>
<table>
  <tr><th>From</th><th>To</th><th>Label</th><th>Source</th></tr>
  {% for f in r.data_flows %}
  <tr><td>{{ f.source_name }}</td><td>{{ f.target_name }}</td><td>{{ f.label or "" }}</td><td>{{ "added by hand" if f.is_manual else "scanned" }}</td></tr>
  {% else %}<tr><td colspan="4" class="muted">No data flows.</td></tr>{% endfor %}
</table>

<h2>Assumptions and scope</h2>
<p class="muted">Facts the owner stated that no scan confirmed, and elements excluded from the model. These shape the threats below, so a reviewer should check them.</p>
{% if r.not_analysed %}
<div class="warn"><strong>{{ r.not_analysed | length }} input{{ "s were" if r.not_analysed | length != 1 else " was" }} stored but not analysed.</strong> The threats below come only from what was analysed or drawn by hand, so a short list is not a clean result.
<ul>{% for a in r.not_analysed %}<li><strong>{{ a.element }}:</strong> {{ a.statement }}</li>{% endfor %}</ul></div>
{% endif %}
{% if r.partly_analysed %}
<div class="warn"><strong>{{ r.partly_analysed | length }} part{{ "s" if r.partly_analysed | length != 1 else "" }} of the inputs {{ "were" if r.partly_analysed | length != 1 else "was" }} not analysed.</strong> The result is incomplete, so a short list below, or "no vulnerabilities", does not mean nothing is there.
<ul>{% for a in r.partly_analysed %}<li><strong>{{ a.element }}:</strong> {{ a.statement }}</li>{% endfor %}</ul></div>
{% endif %}
{% if r.assumptions %}
<table>
  <tr><th>Element</th><th>Type</th><th>Owner states</th></tr>
  {% for a in r.assumptions %}<tr><td>{{ a.element }}</td><td>{{ a.element_type | replace("_", " ") }}</td><td>{{ a.statement }}</td></tr>{% endfor %}
</table>
{% else %}<p>No properties were stated by the owner.</p>{% endif %}
{% if r.out_of_scope %}
<table>
  <tr><th>Out of scope</th><th>Type</th><th>Reason</th></tr>
  {% for a in r.out_of_scope %}<tr><td>{{ a.element }}</td><td>{{ a.element_type | replace("_", " ") }}</td><td>{{ a.statement }}</td></tr>{% endfor %}
</table>
{% endif %}
{% if r.manual_threat_count %}<p>{{ r.manual_threat_count }} threat{{ "s were" if r.manual_threat_count != 1 else " was" }} added by hand (marked "Manual" below).</p>{% endif %}

<h2>Threats ({{ r.summary.total }})</h2>
{% for group in threat_groups %}
<h3 class="element">{{ group.name }} <span class="muted">({{ group.type | replace("_", " ") }})</span></h3>
{% for t in group.threats %}
<div class="threat risk-{{ t.risk }}">
  <div class="title">{{ t.title }}</div>
  <div class="meta">
    <span class="badge {{ t.risk }}">risk: {{ t.risk }}</span>
    impact {{ t.severity }} &middot; likelihood {{ t.likelihood | replace("_", " ") }}
    {% if t.category %}&middot; {{ t.methodology }}: {{ t.category }}{% endif %}
    &middot; status: <b>{{ t.status | replace("_", " ") }}</b>
    {% if t.origin == "manual" %}&middot; Manual{% elif t.origin == "custom_rule" %}&middot; Custom rule{% endif %}
  </div>
  {% if t.note %}<div class="meta">Note: {{ t.note }}</div>{% endif %}
  {% if t.description %}<p style="margin:6px 0">{{ t.description }}</p>{% endif %}
  {% if t.mitigations %}<div><b>Suggested mitigations</b><ul>{% for m in t.mitigations %}<li>{{ m }}</li>{% endfor %}</ul></div>{% endif %}
  {% if t.verification %}<div><b>How to verify</b><ul>{% for v in t.verification %}<li>{{ v }}</li>{% endfor %}</ul></div>{% endif %}
  {% if t.fix_example %}<div><b>Example fix</b><pre>{{ t.fix_example }}</pre></div>{% endif %}
  {% set reasons = t.risk_factors + t.likelihood_factors %}
  {% if reasons %}<div class="meta">Why this likelihood: {{ reasons | join("; ") }}</div>{% endif %}
  {% if t.evidence %}<div class="meta">Supporting findings ({{ t.evidence_total }}): {% for e in t.evidence %}{{ e.title }} ({{ e.severity }}){{ ", " if not loop.last else "" }}{% endfor %}</div>{% endif %}
  {% if t.cwe_refs or t.attack_refs %}<div class="meta">References: {{ (t.cwe_refs + t.attack_refs) | join(", ") }}</div>{% endif %}
</div>
{% endfor %}
{% else %}<p class="muted">No threats were generated.</p>{% endfor %}

{% for section in r.extra_sections %}
<h2>{{ section.title }}</h2>
{% for text in section.paragraphs %}<p>{{ text }}</p>{% endfor %}
{% for table in section.tables %}
<table>
  <tr>{% for h in table.headers %}<th>{{ h }}</th>{% endfor %}</tr>
  {% for row in table.rows %}<tr>{% for cell in row %}<td>{{ cell }}</td>{% endfor %}</tr>{% endfor %}
</table>
{% endfor %}
{% endfor %}

<h2>Findings ({{ r.findings | length }})</h2>
{% if r.findings %}
<table>
  <tr><th>Severity</th><th>Component</th><th>Finding</th><th>Status</th><th>Source</th></tr>
  {% for f in r.findings %}
  <tr><td><span class="badge {{ f.severity }}">{{ f.severity }}</span></td><td>{{ f.element }}</td><td>{{ f.title }}</td><td>{{ f.status | replace("_", " ") }}</td><td>{{ f.source_tool }}</td></tr>
  {% endfor %}
</table>
{% else %}<p class="muted">No findings.</p>{% endif %}

{% if r.sbom %}
<h2>Software bill of materials</h2>
<p>{{ r.sbom.component_count }} application dependencies, {{ r.sbom.vulnerability_count }} known vulnerabilities ({{ r.sbom.format }}).
{% if r.sbom.no_lockfile_detected %}<br><span class="muted">No lockfile was found, so exact dependency versions could not be resolved and the vulnerability count may be understated.</span>{% endif %}</p>
{% if r.sbom.vulnerabilities %}
<table>
  <tr><th>Vulnerability</th><th>Severity</th><th>Package</th></tr>
  {% for v in sbom_vulnerabilities %}<tr><td>{{ v.id }}</td><td>{{ v.severity }}</td><td>{{ v.package }}</td></tr>{% endfor %}
</table>
{% if r.sbom.vulnerabilities | length > sbom_vulnerabilities | length %}<p class="muted">Showing the first {{ sbom_vulnerabilities | length }} of {{ r.sbom.vulnerabilities | length }}.</p>{% endif %}
{% endif %}
{% endif %}
</main>
</body>
</html>
